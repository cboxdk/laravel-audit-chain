# Files that exist for development but must not ship in the Composer package.
# `export-ignore` removes them from `git archive`, which is what Packagist uses to
# build the distributed zip.
/.github          export-ignore
/tests            export-ignore
/BUILD-STATUS.md  export-ignore
/phpstan.neon     export-ignore
/phpunit.xml.dist export-ignore
/pint.json        export-ignore
